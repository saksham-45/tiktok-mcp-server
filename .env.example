# TikTok Developer Portal app credentials (https://developers.tiktok.com)
# Required products: Login Kit, Content Posting API (video.publish scope approved)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8787/callback

# Optional
# TIKTOK_SCOPES=user.info.basic,video.list,video.publish
# TIKTOK_TOKEN_FILE=tiktok-tokens.json
# TRANSPORT=stdio        # or http
# PORT=3000
